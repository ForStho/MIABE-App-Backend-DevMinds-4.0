# ===============================================
# CONFIGURATION BACKEND - Variables d'Environnement
# ===============================================
# Copier ce fichier en .env et remplir toutes les valeurs
# Les variables marquées [REQUIS] doivent obligatoirement être définies
# Pour plus de détails, voir: ENV_CONFIGURATION_GUIDE.md

# ===============================================
# 1. APPLICATION GÉNÉRALE
# ===============================================
# Environnement d'exécution [REQUIS]
NODE_ENV=development

# URL publique de base de l'application [REQUIS]
# Ex: http://localhost:3000, https://api.example.com
BASE_URL=http://localhost:3000

# Port du serveur HTTP
PORT=3000

# Activation du CORS
CORS_ENABLED=true

# Origines CORS autorisées (séparées par virgules, sans espaces)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Niveau de logs (error, warn, info, debug, verbose)
LOG_LEVEL=info

# Préfixe des routes API
API_PREFIX=api

# ===============================================
# 2. BASE DE DONNÉES MONGODB
# ===============================================
# URI de connexion MongoDB [REQUIS]
# Développement:  mongodb://localhost:27017/starter
# Production:     mongodb+srv://user:password@cluster.mongodb.net/starter?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/starter

# Activer le mode debug Mongoose (affiche les requêtes)
MONGODB_DEBUG=false

# Taille du pool de connexions
MONGODB_POOL_SIZE=10

# Nom du replica set (si cluster répliqué)
# MONGODB_REPLICA_SET=rs0

# Activer SSL/TLS
MONGODB_SSL=false

# Base de données d'authentification
# MONGODB_AUTH_SOURCE=admin

# Réessai automatique des écritures
MONGODB_RETRY_WRITES=true

# Préférence de lecture (primary, primaryPreferred, secondary, secondaryPreferred, nearest)
MONGODB_READ_PREFERENCE=primary

# ===============================================
# 3. REDIS
# ===============================================
# Mode: STANDALONE (par défaut)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Mode: CLUSTER (décommenter si activation)
# REDIS_CLUSTER_ENABLED=false
# REDIS_CLUSTER_NODES=redis1:6379,redis2:6379,redis3:6379

# Mode: SENTINEL (décommenter si activation)
# REDIS_SENTINEL_ENABLED=false
# REDIS_SENTINEL_NODES=sentinel1:26379,sentinel2:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster

# ===============================================
# 4. JWT - AUTHENTIFICATION
# ===============================================
# Secret pour les access tokens [REQUIS]
# Générer: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_change_in_production

# Secret pour les refresh tokens [REQUIS] - DOIT ÊTRE DIFFÉRENT
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production

# Durée de vie des access tokens
JWT_EXPIRES_IN=15m

# Durée de vie des refresh tokens
JWT_REFRESH_EXPIRES_IN=7d

# Émetteur du token (optionnel)
# JWT_ISSUER=my-app

# Audience du token (optionnel)
# JWT_AUDIENCE=my-app-users

# ===============================================
# 5. STOCKAGE DE FICHIERS
# ===============================================
# Driver de stockage: local ou s3
STORAGE_DRIVER=local

# Configuration LOCAL
LOCAL_STORAGE_PATH=./uploads

# Configuration S3 (décommenter si STORAGE_DRIVER=s3)
# S3_BUCKET=my-bucket
# S3_REGION=eu-west-1
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...
# S3_ENDPOINT=                    # Optionnel, pour services compatibles S3 (MinIO, etc.)
# S3_FORCE_PATH_STYLE=false      # Optionnel, pour MinIO

# ===============================================
# 6. EMAIL (SMTP)
# ===============================================
# Host SMTP [REQUIS]
MAIL_HOST=smtp.gmail.com

# Port SMTP
MAIL_PORT=587

# Identifiant SMTP [REQUIS]
MAIL_USER=user@gmail.com

# Mot de passe / Token API [REQUIS]
MAIL_PASSWORD=app_password

# Adresse d'expédition [REQUIS]
MAIL_FROM=noreply@example.com

# Mode sécurisé (true = SSL 465, false = STARTTLS 587)
MAIL_SECURE=false



# ===============================================
# 7. FILES D'ATTENTE (BULL)
# ===============================================
# Hôte Redis pour les queues
QUEUE_REDIS_HOST=localhost

# Port Redis pour les queues
QUEUE_REDIS_PORT=6379

# Mot de passe Redis pour les queues
QUEUE_REDIS_PASSWORD=

# Base Redis pour les queues
QUEUE_REDIS_DB=1

# Préfixe des clés Redis
QUEUE_PREFIX=bull

# ===============================================
# 8. SÉCURITÉ
# ===============================================
# Protection contre les attaques par force brute
BRUTE_FORCE_ENABLED=true
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW=300
BRUTE_FORCE_BLOCK_DURATION=900

# Vérification de la réputation IP
IP_REPUTATION_ENABLED=false
# IP_REPUTATION_API_KEY=your_abuseipdb_api_key

# Journalisation des événements sensibles
AUDIT_LOG_ENABLED=true

# Sécurité des refresh tokens
REFRESH_TOKEN_ROTATION_ENABLED=true
REFRESH_TOKEN_REUSE_DETECTION=true

# ===============================================
# 9. TÉLÉMÉTRIE (OpenTelemetry)
# ===============================================
# Activer la collecte des traces distribuées
TELEMETRY_ENABLED=false

# Nom du service dans les traces
TELEMETRY_SERVICE_NAME=backend-starter

# Exportateur: console, otlp, jaeger, zipkin
TELEMETRY_EXPORTER=console

# Endpoint OTLP (si exporter=otlp)
# TELEMETRY_OTLP_ENDPOINT=http://collector:4318/v1/traces

# Endpoint Jaeger (si exporter=jaeger)
# TELEMETRY_JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# Endpoint Zipkin (si exporter=zipkin)
# TELEMETRY_ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans

# ===============================================
# 10. MÉTRIQUES (PROMETHEUS)
# ===============================================
# Exposer les métriques Prometheus
METRICS_ENABLED=false

# Endpoint des métriques
METRICS_ENDPOINT=/metrics

# Préfixe des noms de métriques
METRICS_PREFIX=app_

# ===============================================
# 11. MULTI-TENANT (SAAS)
# ===============================================
# Activer le mode multi-tenant
MULTI_TENANT_ENABLED=false

# Identification du tenant: header, subdomain, jwt
TENANT_IDENTIFIER=header

# Nom de l'en-tête du tenant (si identifier=header)
TENANT_HEADER=X-Tenant-ID

# Isolation des données: database, schema, collection, none
TENANT_DB_ISOLATION=none

# ===============================================
# 12. IDEMPOTENCE
# ===============================================
# Activer la protection idempotence
IDEMPOTENCY_ENABLED=true

# Durée de conservation d'une clé (secondes)
IDEMPOTENCY_TTL=86400

# Nom de l'en-tête idempotence
IDEMPOTENCY_KEY_HEADER=Idempotency-Key

# Préfixe cache/Redis
IDEMPOTENCY_PREFIX=idempotency:

# ===============================================
# 13. FEATURE FLAGS
# ===============================================
# Activer le système de feature flags
FEATURE_FLAGS_ENABLED=true

# Provider: env, redis, database
FEATURE_FLAGS_PROVIDER=env

# TTL du cache des flags (en secondes)
FEATURE_FLAGS_CACHE_TTL=60

# ===============================================
# 14. RÉSILIENCE
# ===============================================
# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_TIMEOUT=5000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Retry
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF=1000

# Timeout Global
TIMEOUT_ENABLED=true
TIMEOUT_DEFAULT=10000

# ===============================================
# 15. LOGS D'ACTIVITÉ
# ===============================================
# Rétention des logs d'activité (jours)
ACTIVITY_LOGS_RETENTION_DAYS=90
